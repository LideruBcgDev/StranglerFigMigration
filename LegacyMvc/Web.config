<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- StackExchange.Redis 接続文字列 -->
    <add key="RedisConnectionString" value="localhost:6379,abortConnect=false,connectTimeout=5000" />
    <!-- EF Core データベースプロバイダー切替: Oracle | Postgres | SqlServer | InMemory -->
    <add key="DatabaseProvider" value="SqlServer" />
    <!-- ClientController / ViewController 用 コマンド定義 (<command name="ITM.APP" command="LegacyMvc.MDL.CommandsLegacyApprovalStore,LegacyMvc.MDL" db="1" />) -->
    <add key="command:ITM.APP" value="LegacyMvc.MDL.CommandsLegacyApprovalStore,LegacyMvc.MDL|db=1" />
    <add key="command:ITM.SCH" value="LegacyMvc.MDL.Commands.ItemSearchCommand,LegacyMvc.MDL|db=1" />
    <add key="command:ITM.SAV" value="LegacyMvc.MDL.Commands.ItemSaveCommand,LegacyMvc.MDL|db=1" />
    <add key="command:DRW.SCH" value="LegacyMvc.MDL.Commands.DrawingSearchCommand,LegacyMvc.MDL|db=1" />
    <add key="command:DRW.SAV" value="LegacyMvc.MDL.Commands.DrawingSaveCommand,LegacyMvc.MDL|db=1" />
    <add key="command:CUS.SCH" value="LegacyMvc.MDL.Commands.CustomerQueryCommand,LegacyMvc.MDL|db=1" />
  </appSettings>
  <connectionStrings>
    <add name="SqlServer" connectionString="Server=localhost,1433;Database=StranglerDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Connect Timeout=2;" />
    <add name="Postgres" connectionString="Host=localhost;Port=5432;Database=strangler_db;Username=postgres;Password=postgres;Timeout=2;" />
    <add name="Oracle" connectionString="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=FREEPDB1)));User Id=system;Password=oracle;Connection Timeout=2;" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8.1" />
    <!-- Redis によるセッション共有設定 (Microsoft.Web.RedisSessionStateProvider / StackExchange.Redis) -->
    <sessionState mode="Custom" customProvider="MySessionStateStore">
      <providers>
        <add name="MySessionStateStore"
             type="Microsoft.Web.Redis.RedisSessionStateProvider"
             host="localhost"
             port="6379"
             accessKey=""
             ssl="false"
             applicationName="StranglerSharedSession"
             connectionTimeoutInMilliseconds="5000"
             operationTimeoutInMilliseconds="1000"
             retryTimeoutInMilliseconds="3000" />
      </providers>
    </sessionState>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
