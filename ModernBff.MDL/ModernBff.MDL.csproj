<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ModernBff と同じターゲットフレームワーク (.NET 10 / .NET 9 自動判定) -->
    <TargetFramework Condition="'$(NETCoreSdkVersion)' != '' And $([System.Version]::Parse('$(NETCoreSdkVersion.Split(`-`)[0])').Major) &lt; 10">net9.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="9.23.60" />
  </ItemGroup>

  <ItemGroup>
    <!-- ワークフロー完了時にレガシー側の BOM承認・図面承認コマンド (VB.NET) を同一トランザクションで直接呼び出すための参照 -->
    <ProjectReference Include="..\LegacyMvc.MDL\LegacyMvc.MDL.vbproj" />
  </ItemGroup>

</Project>
