<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- .NET 10 Web API 設定 (.NET 10 SDK 環境では net10.0、.NET 9 SDK 環境でもそのままビルドできるよう自動判定) -->
    <TargetFramework Condition="'$(NETCoreSdkVersion)' != '' And $([System.Version]::Parse('$(NETCoreSdkVersion.Split(`-`)[0])').Major) &lt; 10">net9.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共通プロジェクト (Common.APP, LegacyMvc.PRM, ModernBff.PRM) およびサーバー側コマンド実行 (ModernBff.MDL, LegacyMvc.MDL) を参照 -->
    <ProjectReference Include="..\Common.APP\Common.APP.vbproj" />
    <ProjectReference Include="..\LegacyMvc.PRM\LegacyMvc.PRM.vbproj" />
    <ProjectReference Include="..\ModernBff.PRM\ModernBff.PRM.csproj" />
    <ProjectReference Include="..\ModernBff.MDL\ModernBff.MDL.csproj" />
    <ProjectReference Include="..\LegacyMvc.MDL\LegacyMvc.MDL.vbproj" />
  </ItemGroup>

</Project>
