{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "Database": {
    "Provider": "SqlServer",
    "AllowedProvidersComment": "Oracle | Postgres | SqlServer | InMemory から選択可能"
  },
  "Authentication": {
    "enableNormalLogin": true,
    "autoRedirectToIdpOnLogin": false,
    "DefaultSsoProviderId": "oidc-entra-primary",
    "OAuthApiClients": [
      {
        "ClientId": "strangler-rest-api-client",
        "ClientSecret": "strangler-rest-api-secret-2026",
        "ClientName": "外部システム連携用 REST API クライアント",
        "Scopes": [ "api.read", "api.write" ]
      }
    ],
    "Providers": [
      {
        "ProviderId": "oidc-entra-primary",
        "DisplayName": "シングルサインイン (Microsoft Entra ID - OIDC)",
        "Protocol": "OIDC",
        "Enabled": true,
        "IsPrimary": true,
        "Issuer": "https://login.microsoftonline.com/common/v2.0"
      },
      {
        "ProviderId": "saml2-enterprise",
        "DisplayName": "シングルサインイン (社内統合IdP - SAML 2.0)",
        "Protocol": "SAML2",
        "Enabled": true,
        "IsPrimary": false,
        "Issuer": "https://idp.enterprise.local/saml2"
      },
      {
        "ProviderId": "oidc-partner-tenant",
        "DisplayName": "シングルサインイン (グループ会社IdP - OIDC)",
        "Protocol": "OIDC",
        "Enabled": true,
        "IsPrimary": false,
        "Issuer": "https://partner-idp.enterprise.local/oauth2/v2.0"
      }
    ],
    "Oidc": {
      "Enabled": true,
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      "ClientId": "strangler-modern-bff-client",
      "CallbackPath": "/api/bff/auth/oidc/callback"
    },
    "Saml2": {
      "Enabled": true,
      "IdpEntityId": "https://idp.enterprise.local/saml2",
      "IdpSsoUrl": "https://idp.enterprise.local/saml2/sso",
      "SpEntityId": "http://localhost:5000/saml2/sp",
      "AssertionConsumerServiceUrl": "/api/bff/auth/saml2/acs"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=3000",
    "SqlServer": "Server=localhost,1433;Database=StranglerDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Connect Timeout=2;",
    "Postgres": "Host=localhost;Port=5432;Database=strangler_db;Username=postgres;Password=postgres;Timeout=2;",
    "Oracle": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=FREEPDB1)));User Id=system;Password=oracle;Connection Timeout=2;"
  },
  "LegacyMvc": {
    "BaseUrl": "http://localhost:5001/"
  },
  "ReverseProxy": {
    "Routes": {
      "legacy-api-explicit-route": {
        "ClusterId": "legacy-mvc-cluster",
        "Order": 1,
        "Match": {
          "Path": "/legacy-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/legacy-api"
          }
        ]
      },
      "legacy-fallback-route": {
        "ClusterId": "legacy-mvc-cluster",
        "Order": 9999,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy-mvc-cluster": {
        "Destinations": {
          "legacy-mvc-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  },
  "StranglerFig": {
    "Mode": "TwoProcessIntegratedGateway",
    "EnableEmbeddedYarp": true,
    "EnableRedisSession": false,
    "EnableWebLoginPage": false,
    "PatternAuthSource": "PatternA_UsrTblPasswordGrant",
    "Description": "【推奨アーキテクチャ: 完全2プロセス構成】ModernBff がポート 5000 で受付窓口となり、YARP を内蔵。自前の REST API / MCP / OAuth は ModernBff が直接処理し、レガシー要求は裏の LegacyMvc (:5001) へ透過転送。Redis は完全撤廃しインメモリ＋ステートレス Bearer トークンで稼働。"
  }
}
