{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "Mode": "Integrated",
  "StranglerFig": {
    "EnableRedisSession": false,
    "EnableWebLoginPage": true,
    "WinFormsClientMode": "Legacy",
    "BrowserClientMode": "IntegratedLogin_LegacyView",
    "ApiClientMode": "OAuthBearer",
    "Description": "【モダン認証集約・レガシーView連携構成】未ログインはモダン側でログイン要求 -> 認証済みのみレガシーへプロキシ (ヘッダー経由でLoginUser共有) -> レガシーView表示。REST API / MCP もモダン側で認証ガード。"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=StranglerDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Connect Timeout=2;",
    "Postgres": "Host=localhost;Port=5432;Database=strangler_db;Username=postgres;Password=postgres;Timeout=2;",
    "Oracle": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=FREEPDB1)));User Id=system;Password=oracle;Connection Timeout=2;"
  },
  "Authentication": {
    "enableNormalLogin": true,
    "autoRedirectToIdpOnLogin": false,
    "OAuthApiClients": [
      {
        "ClientId": "strangler-rest-api-client",
        "ClientSecret": "strangler-rest-api-secret-2026",
        "ClientName": "外部システム連携用 REST API クライアント",
        "Scopes": [ "api.read", "api.write" ]
      }
    ]
  },
  "LegacyMvc": {
    "BaseUrl": "http://localhost:5001/"
  },
  "ReverseProxy": {
    "Routes": {
      "legacy-fallback-route": {
        "ClusterId": "legacy-mvc-cluster",
        "Order": 9999,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy-mvc-cluster": {
        "Destinations": {
          "legacy-mvc-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  }
}
