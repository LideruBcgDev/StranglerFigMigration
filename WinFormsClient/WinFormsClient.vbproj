<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinFormsClient</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionCompare>Binary</OptionCompare>
    <OptionInfer>On</OptionInfer>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共通プロジェクト (Common.APP) と レガシー/モダン双方のパラメータ定義プロジェクト (LegacyMvc.PRM / ModernBff.PRM) を参照 -->
    <ProjectReference Include="..\Common.APP\Common.APP.vbproj" />
    <ProjectReference Include="..\LegacyMvc.PRM\LegacyMvc.PRM.vbproj" />
    <ProjectReference Include="..\ModernBff.PRM\ModernBff.PRM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="client-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
