{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "legacy-route": {
        "ClusterId": "legacy-mvc-cluster",
        "Match": {
          "Path": "/legacy-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/legacy-api"
          }
        ]
      },
      "modern-bff-route": {
        "ClusterId": "modern-bff-cluster",
        "Match": {
          "Path": "/api/bff/{**catch-all}"
        }
      },
      "modern-login-ui-route": {
        "ClusterId": "modern-bff-cluster",
        "Match": {
          "Path": "/login/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy-mvc-cluster": {
        "Destinations": {
          "legacy-mvc-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "modern-bff-cluster": {
        "Destinations": {
          "modern-bff-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
